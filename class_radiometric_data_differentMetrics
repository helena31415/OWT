def plot_final_dissertacao_v4(classification, lon, lat, method_name, filename):
    """
    Versão Final: Histograma com fundo branco e texto interno preto.
    """
    fig = plt.figure(figsize=(22, 12))
    gs = fig.add_gridspec(1, 2, width_ratios=[1.2, 1], wspace=0.3)

    # --- SUBPLOT 1: MAPA ---
    ax_map = fig.add_subplot(gs[0])
    ax_map.set_facecolor('black')
    extent = [lon.min(), lon.max(), lat.min(), lat.max()]

    ax_map.imshow(classification, cmap=cmap_owt, vmin=0, vmax=21,
                  extent=extent, origin='upper', aspect='auto')

    ax_map.set_title(f'Mapa de Classificação: {method_name}', pad=25, fontweight='bold')
    ax_map.set_xlabel('Longitude (°)', labelpad=15)
    ax_map.set_ylabel('Latitude (°)', labelpad=15)
    ax_map.grid(True, linestyle=':', alpha=0.3, color='white')

    # --- SUBPLOT 2: HISTOGRAMA (FUNDO BRANCO) ---
    ax_hist = fig.add_subplot(gs[1])
    ax_hist.set_facecolor('white')

    valid_pixels = classification[classification > 0]
    classes, counts = np.unique(valid_pixels, return_counts=True)
    percentages = 100 * counts / len(valid_pixels)

    bar_colors = [colors_list[int(c)] for c in classes]
    bars = ax_hist.bar(classes, percentages, color=bar_colors, edgecolor='black', linewidth=1.5)

    # Texto das porcentagens
    y_max = max(percentages)
    offset = y_max * 0.02

    for bar, pct in zip(bars, percentages):
        height = bar.get_height()
        ax_hist.text(
            bar.get_x() + bar.get_width()/2.,
            height + offset,
            f'{pct:.1f}%',
            ha='center',
            va='bottom',
            fontsize=15,
            fontweight='black',
            color='black'
        )

    ax_hist.set_title('Distribuição Percentual', pad=30, fontweight='bold')
    ax_hist.set_xlabel('Classes (OWT)', labelpad=15)
    ax_hist.set_ylabel('Frequência (%)', labelpad=15)
    ax_hist.set_xticks(classes)
    ax_hist.set_xticklabels([f'{int(c)}' for c in classes], fontweight='bold')
    ax_hist.set_ylim(0, y_max * 1.15)
    ax_hist.grid(True, axis='y', linestyle='--', alpha=0.3, color='gray')

    # --- LEGENDA VERTICAL ---
    legend_elements = [Patch(facecolor=colors_list[int(c)], edgecolor='black',
                             label=f'OWT {int(c)}') for c in sorted(classes)]
    legend_elements.insert(0, Patch(facecolor='black', edgecolor='black', label='Inválido/Nuvem'))

    ax_hist.legend(handles=legend_elements,
                   loc='center left',
                   bbox_to_anchor=(1.05, 0.5),
                   title="Legenda de Classes",
                   prop={'size': 18, 'weight': 'bold'},
                   frameon=True,
                   facecolor='white',
                   edgecolor='black',
                   labelspacing=1.3)

    plt.tight_layout(rect=[0, 0, 0.9, 1])
    plt.savefig(filename, dpi=300, bbox_inches='tight', facecolor='white')
    plt.show()

