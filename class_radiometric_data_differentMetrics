def classify_pixel_sam(pixel_spectrum, owts_spectra):
    """Classifica pixel com SAM"""
    min_angle = np.inf
    best_owt = -1
    confidence = np.inf

    for owt_idx in owts_spectra.index:
        angle = sam(pixel_spectrum, owts_spectra.loc[owt_idx].values)
        if angle < min_angle:
            min_angle = angle
            best_owt = owt_idx
            confidence = angle

    return best_owt, confidence

def classify_pixel_manhattan(pixel_spectrum, owts_spectra):
    """Classifica pixel com Manhattan categórico"""
    min_dist = np.inf
    best_owt = -1
    confidence = np.inf

    for owt_idx in owts_spectra.index:
        dist = manhattan_categorico(pixel_spectrum, owts_spectra.loc[owt_idx].values)
        if dist < min_dist:
            min_dist = dist
            best_owt = owt_idx
            confidence = dist

    return best_owt, confidence

def classify_pixel_manhattan_derivative(pixel_spectrum, owts_spectra):
    """Classifica pixel com Manhattan da derivada discreta"""
    min_dist = np.inf
    best_owt = -1
    confidence = np.inf

    for owt_idx in owts_spectra.index:
        dist = manhattan_derivative(pixel_spectrum, owts_spectra.loc[owt_idx].values)
        if dist < min_dist:
            min_dist = dist
            best_owt = owt_idx
            confidence = dist

    return best_owt, confidence

def classify_pixel_euclidean_spline(pixel_spectrum, owts_spectra, wavelengths):
    """Classifica pixel com Euclidiana da segunda derivada (spline)"""
    min_dist = np.inf
    best_owt = -1
    confidence = np.inf

    for owt_idx in owts_spectra.index:
        dist = euclidiana_segunda_derivada(pixel_spectrum,
                                          owts_spectra.loc[owt_idx].values,
                                          wavelengths)
        if dist < min_dist:
            min_dist = dist
            best_owt = owt_idx
            confidence = dist

    return best_owt, confidence

def classify_image_olci(image_data, owts_df, wavelengths, method='sam', **kwargs):
    """
    Classifica imagem OLCI pixel a pixel com suporte para todos os métodos
    """
    n_bands, n_rows, n_cols = image_data.shape
    classification = np.zeros((n_rows, n_cols), dtype=int)
    confidence = np.zeros((n_rows, n_cols), dtype=float)

    print(f"\n📊 Classificando imagem {n_rows}x{n_cols} pixels com método: {method}...")
    total_pixels = n_rows * n_cols
    processed = 0
    invalid_pixels = 0

    # ✅ Pré-processamento fora do loop (IMPORTANTE para performance)
    if method == 'manhattan_quant':
        owts_transformed = transform_to_quantized_owts(owts_df)

    for i in range(n_rows):
        for j in range(n_cols):
            pixel = image_data[:, i, j]

            # Verificar pixel válido
            if np.isnan(pixel).any() or np.all(pixel <= 0) or np.all(pixel == 0):
                classification[i, j] = 0
                confidence[i, j] = np.nan
                invalid_pixels += 1
                continue

            # Classificar baseado no método
            if method == 'sam':
                best_owt, conf = classify_pixel_sam(pixel, owts_df)

            elif method == 'manhattan_quant':
                pixel_transformed = transform_to_quantized_pixel(pixel)
                best_owt, conf = classify_pixel_manhattan(
                    pixel_transformed,
                    owts_transformed
                )

            elif method == 'manhattan_derivative':
                best_owt, conf = classify_pixel_manhattan_derivative(pixel, owts_df)

            elif method == 'euclidean_spline':
                best_owt, conf = classify_pixel_euclidean_spline(
                    pixel, owts_df, wavelengths
                )

            else:
                raise ValueError(f"Método desconhecido: {method}")

            classification[i, j] = best_owt
            confidence[i, j] = conf

            processed += 1
            if processed % 50000 == 0:
                print(f"  Progresso: {processed}/{total_pixels} ({100*processed/total_pixels:.1f}%)")

    print(f"\n✅ Classificação concluída!")
    print(f"  Pixels válidos: {total_pixels - invalid_pixels}")
    print(f"  Pixels inválidos: {invalid_pixels}")

    return classification, confidence
