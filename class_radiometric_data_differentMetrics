def plot_class_histogram(classification, title, filename):
    """
    Plota histograma de frequência das classes
    """
    # Contar pixels válidos (classe > 0)
    valid_pixels = classification[classification > 0]
    classes, counts = np.unique(valid_pixels, return_counts=True)
    percentages = 100 * counts / len(valid_pixels) if len(valid_pixels) > 0 else counts

    fig, ax = plt.subplots(figsize=(12, 6))

    # Cores para cada classe
    bar_colors = [colors_list[int(c)] for c in classes]

    # Plotar barras
    bars = ax.bar(classes, percentages, color=bar_colors, edgecolor='black', linewidth=0.5)

    # Adicionar valores nas barras
    for bar, pct in zip(bars, percentages):
        height = bar.get_height()
        ax.text(bar.get_x() + bar.get_width()/2., height + 0.5,
                f'{pct:.1f}%', ha='center', va='bottom', fontsize=9)

    # Configurar
    ax.set_xlabel('Classe OWT', fontsize=12)
    ax.set_ylabel('Frequência (%)', fontsize=12)
    ax.set_title(title, fontsize=14, fontweight='bold')
    ax.set_xticks(classes)
    ax.set_xticklabels([f'OWT {int(c)}' for c in classes])
    ax.grid(True, alpha=0.3, axis='y')

    # Adicionar informação de total
    total_valid = len(valid_pixels)
    total_invalid = np.sum(classification == 0)
    ax.text(0.02, 0.98, f'Pixels válidos: {total_valid}\nPixels inválidos: {total_invalid}',
            transform=ax.transAxes, fontsize=10, verticalalignment='top',
            bbox=dict(boxstyle='round', fc='white', alpha=0.8))

    plt.tight_layout()
    plt.savefig(filename, dpi=300, bbox_inches='tight')
    plt.show()
    print(f"  Histograma salvo: {filename}")

