def sam(spectrum1, spectrum2):
    """Spectral Angle Mapper"""
    s1 = np.asarray(spectrum1, dtype=np.float64)
    s2 = np.asarray(spectrum2, dtype=np.float64)

    dot_product = np.dot(s1, s2)
    norm1 = np.linalg.norm(s1)
    norm2 = np.linalg.norm(s2)

    if norm1 == 0 or norm2 == 0:
        return np.pi/2

    cos_theta = np.clip(dot_product / (norm1 * norm2), -1, 1)
    return np.arccos(cos_theta)

def transform_to_quantized_pixel(pixel_spectrum, n_classes=5):
    """
    Quantização uniforme min-max por pixel
    """
    pixel = np.asarray(pixel_spectrum, dtype=float)

    min_val = pixel.min()
    max_val = pixel.max()

    # Evitar divisão por zero
    if max_val == min_val:
        return np.zeros_like(pixel, dtype=int)

    delta = (max_val - min_val) / n_classes

    q = np.floor((pixel - min_val) / delta).astype(int)

    # Clamp para garantir intervalo válido
    q = np.clip(q, 0, n_classes - 1)

    return q

def transform_to_quantized_owts(owts_df, n_classes=5):
    """
    Quantização uniforme min-max por espectro (OWT)
    """
    owts_copy = owts_df.copy()
    quantized_values = np.zeros_like(owts_copy.values, dtype=int)

    for i, owt_idx in enumerate(owts_copy.index):
        spectrum = owts_copy.loc[owt_idx].values.astype(float)

        min_val = spectrum.min()
        max_val = spectrum.max()

        # Evitar divisão por zero
        if max_val == min_val:
            quantized_values[i, :] = 0
            continue

        delta = (max_val - min_val) / n_classes

        q = np.floor((spectrum - min_val) / delta).astype(int)
        q = np.clip(q, 0, n_classes - 1)

        quantized_values[i, :] = q

    return pd.DataFrame(
        quantized_values,
        index=owts_df.index,
        columns=owts_df.columns
    )

def manhattan_categorico(dados1, dados2):
    """Distância Manhattan para dados categóricos"""
    return np.sum(np.abs(np.asarray(dados1, dtype=int) - np.asarray(dados2, dtype=int)))
