def normalize_owts_by_integral(owts_df):
    """
    Normaliza as OWTs pela integral sobre a curva (área = 1)
    """
    owts_norm = owts_df.copy()
    wavelengths = owts_df.columns.astype(float).values

    for owt_idx in owts_df.index:
        spectrum = owts_df.loc[owt_idx].values
        # Calcular integral (área sob a curva)
        area = np.trapz(spectrum, wavelengths)
        if area > 0:
            owts_norm.loc[owt_idx] = spectrum / area
        else:
            print(f"  ⚠️ OWT {owt_idx} tem área zero ou negativa: {area}")

    return owts_norm

def normalize_l2(spectrum):
    """
    Normalização L2 (energia = 1)
    """
    norm = np.linalg.norm(spectrum)
    if norm > 0:
        return spectrum / norm
    return spectrum

