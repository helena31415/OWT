def derivada_discreta(spectrum):
    """
    Calcula a primeira derivada discreta (diferença finita forward)
    e normaliza por L2
    """
    deriv = np.diff(spectrum)
    return (deriv)

def manhattan_derivative(pixel, reference):
    """
    Calcula a soma das diferenças absolutas entre a primeira derivada discreta
    do pixel e do espectro de referência, ambos normalizados por L2.
    """
    # Calcular derivadas discretas e normalizar L2
    deriv_pixel = derivada_discreta(pixel)
    deriv_ref = derivada_discreta(reference)

    # Soma das diferenças absolutas
    return np.sum(np.abs(deriv_pixel - deriv_ref))

def segunda_derivada_spline(spectrum, wavelengths):
    """
    Calcula a segunda derivada usando cubic spline e normaliza por L2
    Versão corrigida sem usar scipy.misc.derivative
    """
    from scipy.interpolate import CubicSpline
    import numpy as np

    # Criar spline cúbica
    cs = CubicSpline(wavelengths, spectrum)

    # Criar pontos mais densos para calcular derivadas
    wavelengths_dense = np.linspace(wavelengths.min(), wavelengths.max(), 100)

    # Calcular primeira e segunda derivadas nos pontos densos
    primeira_deriv = cs.derivative()(wavelengths_dense)
    segunda_deriv = cs.derivative(2)(wavelengths_dense)

    # Amostrar a segunda derivada nos comprimentos de onda originais
    # (ou podemos manter a versão densa - vou manter nos pontos originais para consistência)
    indices = np.searchsorted(wavelengths_dense, wavelengths)
    indices = np.clip(indices, 0, len(wavelengths_dense)-1)
    segunda_deriv_amostrada = segunda_deriv[indices]

    # Remover primeiro e último ponto se necessário (derivadas podem ser instáveis nas bordas)
    # Opção: usar apenas pontos internos
    # segunda_deriv_amostrada = segunda_deriv_amostrada[1:-1]

    return (segunda_deriv_amostrada)

def segunda_derivada_spline_alternativa(spectrum, wavelengths):
    """
    Versão alternativa usando diferenças finitas de alta ordem
    baseada na spline nos pontos originais
    """
    from scipy.interpolate import CubicSpline

    # Criar spline cúbica
    cs = CubicSpline(wavelengths, spectrum)

    # Calcular segunda derivada nos pontos originais
    segunda_deriv = np.zeros_like(spectrum)

    # Usar derivada de 2ª ordem da spline
    for i, wl in enumerate(wavelengths):
        # A spline do scipy tem método para derivada de 2ª ordem
        segunda_deriv[i] = cs(wl, 2)  # O argumento 2 indica derivada de 2ª ordem

    return normalize_l2(segunda_deriv)

def euclidiana_segunda_derivada(pixel, reference, wavelengths):
    """
    Distância Euclidiana entre as segundas derivadas (cubic spline)
    normalizadas por L2
    """
    # Usar a versão alternativa que é mais estável
    d2_pixel = segunda_derivada_spline_alternativa(pixel, wavelengths)
    d2_ref = segunda_derivada_spline_alternativa(reference, wavelengths)

    # Distância Euclidiana
    return np.linalg.norm(d2_pixel - d2_ref)

