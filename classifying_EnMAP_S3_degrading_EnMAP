import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import confusion_matrix

labels = np.arange(1, 22)

def extrair_autovetores_confusao(en_data, s3_data, metodo, n_modos=5):

    # -------------------------
    # 1. FILTRO
    # -------------------------
    mask = (en_data > 0) & (s3_data > 0)
    y_true = s3_data[mask].flatten()
    y_pred = en_data[mask].flatten()

    # -------------------------
    # 2. MATRIZ NORMALIZADA
    # -------------------------
    cm = confusion_matrix(y_true, y_pred, labels=labels)
    cm_norm = cm.astype(float) / (cm.sum(axis=1)[:, None] + 1e-9)

    # -------------------------
    # 3. AUTOVALORES/VETORES
    # -------------------------
    eigvals, eigvecs = np.linalg.eig(cm_norm.T)

    # Parte real (evita ruído numérico complexo)
    eigvals = np.real(eigvals)
    eigvecs = np.real(eigvecs)

    # -------------------------
    # 4. ORDENAR
    # -------------------------
    idx = np.argsort(eigvals)[::-1]
    eigvals_sorted = eigvals[idx]
    eigvecs_sorted = eigvecs[:, idx]

    # -------------------------
    # 5. SELECIONAR TOP MODOS
    # -------------------------
    modos = eigvecs_sorted[:, :n_modos]

    # -------------------------
    # 6. PLOT
    # -------------------------
    fig, axes = plt.subplots(n_modos, 1, figsize=(10, 2*n_modos))

    for i in range(n_modos):
        ax = axes[i]
        ax.bar(labels, modos[:, i])
        ax.set_title(f'{metodo} - Autovetor {i+1} (λ={eigvals_sorted[i]:.3f})')
        ax.set_xlabel('OWT')
        ax.set_ylabel('Peso')
        ax.grid(alpha=0.3)

    plt.tight_layout()
    plt.show()

    return {
        'eigvals': eigvals_sorted,
        'eigvecs': eigvecs_sorted,
        'modos': modos,
        'cm_norm': cm_norm
    }

