wl_common = np.arange(350, 1100, 0.1)
from scipy.interpolate import interp1d

srf_bandas = {}

for band in range(1, 22):

    ch_start = (band - 1) * 15
    ch_end   = band * 15

    srfs_interp = []

    for f in files[ch_start:ch_end]:

        data = pd.read_csv(
            f,
            skiprows=4,
            sep=r"\s+",
            names=["wn", "resp"]
        )

        # Conversão cm⁻¹ → nm
        wl = 1e7 / data["wn"].values
        resp = data["resp"].values

        # Ordenar crescente
        idx = np.argsort(wl)
        wl = wl[idx]
        resp = resp[idx]

        # Interpolar na grade comum
        f_interp = interp1d(
            wl,
            resp,
            bounds_error=False,
            fill_value=0
        )

        srfs_interp.append(f_interp(wl_common))

    # Média dos 15 detectores
    srf_mean = np.mean(srfs_interp, axis=0)

    # Normalizar área para 1
    area = np.trapz(srf_mean, wl_common)
    if area > 0:
        srf_mean /= area

    srf_bandas[band] = srf_mean

print("✅ SRFs médias criadas corretamente.")

for band in range(1, 22):
    peak = wl_common[np.argmax(srf_bandas[band])]
    print(f"Banda {band}: pico em {round(peak,2)} nm")

