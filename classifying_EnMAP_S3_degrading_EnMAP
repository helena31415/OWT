import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.metrics import confusion_matrix
from scipy.cluster.hierarchy import linkage, dendrogram, fcluster
from sklearn.manifold import MDS

# =========================
# CONFIG
# =========================
labels = np.arange(1, 22)
labels_str = [f'OWT_{i}' for i in labels]

# =========================
# FUNÇÃO PRINCIPAL
# =========================
def analyze_confusion_pipeline(en_data, s3_data, metodo, save_prefix='output'):

    # -------------------------
    # 1. FILTRO
    # -------------------------
    mask = (en_data > 0) & (s3_data > 0)
    y_true = s3_data[mask].flatten()
    y_pred = en_data[mask].flatten()

    # -------------------------
    # 2. MATRIZ DE CONFUSÃO
    # -------------------------
    cm = confusion_matrix(y_true, y_pred, labels=labels)

    cm_norm = cm.astype(float) / (cm.sum(axis=1)[:, None] + 1e-9)

    # -------------------------
    # 3. SIMETRIZAÇÃO (estrutura)
    # -------------------------
    S = (cm_norm + cm_norm.T) / 2

    # -------------------------
    # 4. DECOMPOSIÇÃO ESPECTRAL
    # -------------------------
    eigvals, eigvecs = np.linalg.eig(cm_norm.T)

    # -------------------------
    # 5. CLUSTER HIERÁRQUICO
    # -------------------------
    Z = linkage(S, method='ward')

    # cortar em N grupos (ajuste conforme necessário)
    grupos = fcluster(Z, t=5, criterion='maxclust')

    # -------------------------
    # 6. EMBEDDING (MDS)
    # -------------------------
    dist = 1 - S
    mds = MDS(n_components=2, dissimilarity='precomputed', random_state=42)
    coords = mds.fit_transform(dist)

    # -------------------------
    # 7. PLOTS
    # -------------------------
    fig = plt.figure(figsize=(20, 12))

    # Heatmap
    plt.subplot(2,2,1)
    sns.heatmap(cm_norm, cmap='YlGnBu',
                xticklabels=labels, yticklabels=labels)
    plt.title(f'{metodo} - Confusão Normalizada')
    plt.xlabel('Predição')
    plt.ylabel('Referência')

    # Dendrograma
    plt.subplot(2,2,2)
    dendrogram(Z, labels=labels)
    plt.title('Dendrograma (estrutura de confusão)')

    # Embedding
    plt.subplot(2,2,3)
    plt.scatter(coords[:,0], coords[:,1])
    for i, txt in enumerate(labels):
        plt.text(coords[i,0], coords[i,1], str(txt))
    plt.title('Embedding (MDS)')

    # Autovalores
    plt.subplot(2,2,4)
    plt.plot(np.sort(np.real(eigvals))[::-1], 'o-')
    plt.title('Espectro de Autovalores')

    plt.tight_layout()
    plt.savefig(f'{save_prefix}_{metodo}.png', dpi=300)
    plt.show()

    # -------------------------
    # 8. EXPORTAÇÃO
    # -------------------------
    df_cm = pd.DataFrame(cm, index=labels_str, columns=labels_str)
    df_norm = pd.DataFrame(cm_norm, index=labels_str, columns=labels_str)
    df_sim = pd.DataFrame(S, index=labels_str, columns=labels_str)
    df_embed = pd.DataFrame(coords, index=labels_str, columns=['Dim1','Dim2'])
    df_groups = pd.DataFrame(grupos, index=labels_str, columns=['Grupo'])
    df_eig = pd.DataFrame({
        'autovalor': eigvals.real
    })

    with pd.ExcelWriter(f'{save_prefix}_{metodo}.xlsx') as writer:
        df_cm.to_excel(writer, 'Confusao_Absoluta')
