def get_rgb_stretched(data_cube, wls, r_target=665, g_target=560, b_target=443):
    """Localiza bandas próximas aos alvos e aplica realce de contraste"""
    # Encontrar índices das bandas mais próximas
    idx_r = np.abs(wls - r_target).argmin()
    idx_g = np.abs(wls - g_target).argmin()
    idx_b = np.abs(wls - b_target).argmin()

    print(f"   Usando bandas EnMAP: R={wls[idx_r]:.1f}nm, G={wls[idx_g]:.1f}nm, B={wls[idx_b]:.1f}nm")

    rgb = np.stack([data_cube[idx_r], data_cube[idx_g], data_cube[idx_b]], axis=-1)

    # Tratamento de dados: remover NaNs e valores negativos
    rgb = np.nan_to_num(rgb, nan=0.0)
    rgb[rgb < 0] = 0

    # Realce de contraste (Linear Stretch 2% - 98%)
    for i in range(3):
        p2, p98 = np.percentile(rgb[..., i], (2, 98))
        if p98 > p2:
            rgb[..., i] = np.clip((rgb[..., i] - p2) / (p98 - p2), 0, 1)

    return rgb

