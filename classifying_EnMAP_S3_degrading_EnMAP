def parse_enmap_metadata(xml_path):
    """Extrai comprimentos de onda dos metadados EnMAP"""
    tree = ET.parse(xml_path)
    root = tree.getroot()
    wavelengths = []
    for band in root.findall(".//bandID"):
        wl = band.findtext("wavelengthCenterOfBand")
        if wl:
            wavelengths.append(float(wl))
    return np.array(wavelengths)

