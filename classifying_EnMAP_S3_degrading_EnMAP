import time

# ============================================================================
# 3. FUNÇÕES DE CLASSIFICAÇÃO VETORIZADAS
# ============================================================================
def normalize_by_integral(spectra_matrix, wavelengths):
    """
    Normaliza espectros pela integral (área = 1)

    Args:
        spectra_matrix: array (n_spectra, n_bands) - espectros a normalizar
        wavelengths: array (n_bands,) - comprimentos de onda

    Returns:
        array normalizado com área = 1 para cada espectro
    """
    integrals = np.trapz(spectra_matrix, wavelengths, axis=1)
    integrals = integrals.reshape(-1, 1)
    integrals[integrals == 0] = 1
    return spectra_matrix / integrals
def normalize_owts_by_integral(owts_df):
    """
    Normaliza as OWTs pela integral sobre a curva (área = 1)
    """
    owts_norm = owts_df.copy()
    wavelengths = owts_df.columns.astype(float).values

    for owt_idx in owts_df.index:
        spectrum = owts_df.loc[owt_idx].values
        area = np.trapz(spectrum, wavelengths)
        if area > 0:
            owts_norm.loc[owt_idx] = spectrum / area
        else:
            print(f"  ⚠️ OWT {owt_idx} tem área zero ou negativa: {area}")

    return owts_norm

def sam_vectorized(pixels_matrix, owts_matrix):
    """
    Spectral Angle Mapper vetorizado
    """
    pixel_norms = np.linalg.norm(pixels_matrix, axis=1, keepdims=True)
    pixel_norms[pixel_norms == 0] = 1
    pixels_l2 = pixels_matrix / pixel_norms

    owt_norms = np.linalg.norm(owts_matrix, axis=1, keepdims=True)
    owt_norms[owt_norms == 0] = 1
    owts_l2 = owts_matrix / owt_norms

    dot_products = np.dot(pixels_l2, owts_l2.T)
    dot_products = np.clip(dot_products, -1, 1)
    angles = np.arccos(dot_products)

    best_owts = np.argmin(angles, axis=1) + 1
    min_angles = np.min(angles, axis=1)

    return best_owts, min_angles

def manhattan_quantized_vectorized(pixels_matrix, owts_matrix, n_quantis=5):
    """
    Manhattan com quantização MIN-MAX (consistente espectralmente)
    """
    n_pixels, n_bands = pixels_matrix.shape
    n_owts = owts_matrix.shape[0]

    pixels_clean = np.nan_to_num(pixels_matrix, nan=0.0)
    owts_clean = np.nan_to_num(owts_matrix, nan=0.0)

    # Normalização MIN-MAX
    p_min = pixels_clean.min(axis=1, keepdims=True)
    p_max = pixels_clean.max(axis=1, keepdims=True)
    p_range = p_max - p_min
    p_range[p_range == 0] = 1
    pixels_norm = (pixels_clean - p_min) / p_range

    o_min = owts_clean.min(axis=1, keepdims=True)
    o_max = owts_clean.max(axis=1, keepdims=True)
    o_range = o_max - o_min
    o_range[o_range == 0] = 1
    owts_norm = (owts_clean - o_min) / o_range

    # Quantização uniforme
    pixels_quantized = np.floor(pixels_norm * (n_quantis - 1)).astype(int)
    owts_quantized = np.floor(owts_norm * (n_quantis - 1)).astype(int)
    pixels_quantized = np.clip(pixels_quantized, 0, n_quantis - 1)
    owts_quantized = np.clip(owts_quantized, 0, n_quantis - 1)

    # Distância Manhattan
    distances = np.zeros((n_pixels, n_owts))
    for i in range(n_owts):
        diff = np.abs(pixels_quantized - owts_quantized[i])
        distances[:, i] = np.sum(diff, axis=1)

    best_owts = np.argmin(distances, axis=1) + 1
    min_distances = np.min(distances, axis=1)

    return best_owts, min_distances

def derivative_manhattan_vectorized(pixels_matrix, owts_matrix):
    """
    Manhattan da derivada discreta
    """
    pixels_deriv = np.diff(pixels_matrix, axis=1)
    owts_deriv = np.diff(owts_matrix, axis=1)

    n_pixels = pixels_deriv.shape[0]
    n_owts = owts_deriv.shape[0]
    distances = np.zeros((n_pixels, n_owts))

    for i in range(n_owts):
        diff = np.abs(pixels_deriv - owts_deriv[i])
        distances[:, i] = np.sum(diff, axis=1)

    best_owts = np.argmin(distances, axis=1) + 1
    min_distances = np.min(distances, axis=1)

    return best_owts, min_distances

def classify_image_vectorized(image_data, owts_df, wavelengths, method='sam', batch_size=5000):
    """
    Classifica imagem de forma vetorizada
    """
    n_bands, n_rows, n_cols = image_data.shape
    n_pixels = n_rows * n_cols
    n_owts = len(owts_df)

    print(f"\n📊 Iniciando classificação vetorizada:")
    print(f"  Dimensões: {n_rows}x{n_cols} = {n_pixels} pixels")
    print(f"  Bandas: {n_bands}")
    print(f"  OWTs: {n_owts}")
    print(f"  Método: {method}")
    print(f"  Batch size: {batch_size}")

    start_time = time.time()

    owts_matrix = owts_df.values.astype(np.float32)
    print("  Normalizando OWTs pela integral...")
    owts_matrix = normalize_by_integral(owts_matrix, wavelengths)

    image_2d = image_data.reshape(n_bands, n_pixels).T.astype(np.float32)
    valid_mask = ~np.isnan(image_2d).any(axis=1)
    valid_indices = np.where(valid_mask)[0]
    n_valid = len(valid_indices)

    print(f"  Pixels válidos: {n_valid}/{n_pixels} ({100*n_valid/n_pixels:.1f}%)")

    if n_valid == 0:
        print("  ⚠️ Nenhum pixel válido encontrado!")
        return np.zeros((n_rows, n_cols), dtype=int), np.zeros((n_rows, n_cols))

    valid_pixels = image_2d[valid_indices]
    print("  Normalizando pixels válidos pela integral...")
    valid_pixels_norm = normalize_by_integral(valid_pixels, wavelengths)

    classification = np.zeros(n_pixels, dtype=int)
    confidence = np.zeros(n_pixels, dtype=np.float32)

    n_batches = (n_valid + batch_size - 1) // batch_size
    print(f"  Processando em {n_batches} lotes...")

    for batch_idx, start_idx in enumerate(range(0, n_valid, batch_size)):
        end_idx = min(start_idx + batch_size, n_valid)
        batch_indices = valid_indices[start_idx:end_idx]
        batch_pixels = valid_pixels_norm[start_idx:end_idx]

        batch_start = time.time()
        print(f"    Lote {batch_idx + 1}/{n_batches}: {len(batch_pixels)} pixels...")

        if method == 'sam':
            best_owts, conf = sam_vectorized(batch_pixels, owts_matrix)
        elif method == 'manhattan_quant':
            best_owts, conf = manhattan_quantized_vectorized(batch_pixels, owts_matrix)
        elif method == 'manhattan_derivative':
            best_owts, conf = derivative_manhattan_vectorized(batch_pixels, owts_matrix)
        else:
            raise ValueError(f"Método desconhecido: {method}")

        classification[batch_indices] = best_owts
        confidence[batch_indices] = conf

        batch_time = time.time() - batch_start
        print(f"      Lote concluído em {batch_time:.1f}s")

    classification = classification.reshape(n_rows, n_cols)
    confidence = confidence.reshape(n_rows, n_cols)
    invalid_mask_2d = (~valid_mask).reshape(n_rows, n_cols)
    classification[invalid_mask_2d] = 0
    confidence[invalid_mask_2d] = np.nan

    total_time = time.time() - start_time
    print(f"\n✅ Classificação concluída em {total_time/60:.1f} minutos!")
    print(f"  Pixels classificados: {n_valid}")

    return classification, confidence

