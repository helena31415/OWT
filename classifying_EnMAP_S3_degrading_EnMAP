import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import confusion_matrix
from sklearn.manifold import MDS

# =========================
# CONFIG
# =========================
labels = np.arange(1, 22)

# =========================
# FUNÇÕES BASE
# =========================

def compute_confusion(en_data, s3_data):
    mask = (en_data > 0) & (s3_data > 0)
    y_true = s3_data[mask].flatten()
    y_pred = en_data[mask].flatten()

    cm = confusion_matrix(y_true, y_pred, labels=labels)
    cm_norm = cm.astype(float) / (cm.sum(axis=1)[:, None] + 1e-9)

    return cm, cm_norm


def spectral_decomposition(cm_norm, n_modes=5):
    eigvals, eigvecs = np.linalg.eig(cm_norm.T)

    eigvals = np.real(eigvals)
    eigvecs = np.real(eigvecs)

    idx = np.argsort(eigvals)[::-1]

    return eigvals[idx], eigvecs[:, idx][:, :n_modes]


def espectro_modo(modo, espectros):
    return np.dot(modo, espectros)


def separabilidade(a, b):
    return np.linalg.norm(a - b)


# =========================
# PIPELINE PRINCIPAL
# =========================

def pipeline_confusao_espectral(en_data, s3_data, metodo,
                               owts_enmap_norm, owts_olci_norm,
                               n_modes=5, save=False):

    # -------------------------
    # 1. MATRIZ
    # -------------------------
    cm, cm_norm = compute_confusion(en_data, s3_data)

    # -------------------------
    # 2. DECOMPOSIÇÃO
    # -------------------------
    eigvals, modos = spectral_decomposition(cm_norm, n_modes)

    # -------------------------
    # 3. LOOP NOS MODOS
    # -------------------------
    resultados = []

    for k in range(n_modes):

        modo = modos[:, k]

        # separar grupos
        pos = modo > 0
        neg = modo < 0

        # espectros médios
        spec_pos_enmap = owts_enmap_norm[pos].mean(axis=0)
        spec_neg_enmap = owts_enmap_norm[neg].mean(axis=0)

        spec_pos_olci = owts_olci_norm[pos].mean(axis=0)
        spec_neg_olci = owts_olci_norm[neg].mean(axis=0)

        # separabilidade
        sep_enmap = separabilidade(spec_pos_enmap, spec_neg_enmap)
        sep_olci = separabilidade(spec_pos_olci, spec_neg_olci)

        resultados.append({
            'modo': k+1,
            'autovalor': eigvals[k],
            'sep_enmap': sep_enmap,
            'sep_olci': sep_olci,
            'n_pos': pos.sum(),
            'n_neg': neg.sum()
        })

        # -------------------------
        # 4. PLOTS
        # -------------------------
        fig, axes = plt.subplots(1,3, figsize=(18,4))

        # Autovetor
        axes[0].bar(labels, modo)
        axes[0].set_title(f'{metodo} - Autovetor {k+1} (λ={eigvals[k]:.3f})')
        axes[0].set_xlabel('OWT')
        axes[0].set_ylabel('Peso')

        # EnMAP
        axes[1].plot(spec_pos_enmap, label='Positivo')
        axes[1].plot(spec_neg_enmap, label='Negativo')
        axes[1].set_title(f'EnMAP (sep={sep_enmap:.3f})')
        axes[1].legend()

        # OLCI
        axes[2].plot(spec_pos_olci, label='Positivo')
        axes[2].plot(spec_neg_olci, label='Negativo')
        axes[2].set_title(f'OLCI (sep={sep_olci:.3f})')
        axes[2].legend()

        plt.tight_layout()
        plt.show()

    # -------------------------
    # 5. TABELA FINAL
    # -------------------------
    df_resultados = pd.DataFrame(resultados)

    print(f'\n===== {metodo} =====')
    print(df_resultados)

    if save:
        df_resultados.to_excel(f'resultados_{metodo}.xlsx', index=False)

    return {
        'cm': cm,
        'cm_norm': cm_norm,
        'eigvals': eigvals,
        'modos': modos,
        'resumo': df_resultados
    }

